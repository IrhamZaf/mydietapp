# ==============================================================================
# MyDiet Flutter Frontend - Production Environment Reference (.env.production)
# Domain: mydiet.vinculotech.com
# ==============================================================================

# Production API Endpoint
API_BASE_URL=https://mydiet.vinculotech.com/api/v1

# Flutter Build Command for Production Android APK:
# flutter build apk --release --dart-define=BASE_URL=https://mydiet.vinculotech.com/api/v1

# Flutter Build Command for Production App Bundle (Google Play):
# flutter build appbundle --release --dart-define=BASE_URL=https://mydiet.vinculotech.com/api/v1

# Flutter Build Command for Web:
# flutter build web --release --dart-define=BASE_URL=https://mydiet.vinculotech.com/api/v1
